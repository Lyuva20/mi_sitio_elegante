---
import "../styles/style.css"
import "../styles/variables.css"
import Nav from "../component/nav.astro"
import Footer from "../component/footer.astro"
import Head from "../component/head.astro"
import Header from "../component/header.astro"
import Banner from "../component/banner.astro"



const {titulo, parrafo} = Astro.props;
const {tituloDos, parrafoDos, boton} = Astro.props;
const {title, description} = Astro.props;

---

<!DOCTYPE html>

<html lang="es" transition:animate="fade">

<Head title={title} description={description}/>

<body>

<Nav/>


{titulo && parrafo ? <Header titulo={titulo} parrafo={parrafo} /> : null}


<slot/>


{tituloDos && parrafoDos && boton ? <Banner tituloDos={tituloDos} parrafoDos={parrafoDos} boton={boton} /> : null}

<Footer/>



</body>
</html>
