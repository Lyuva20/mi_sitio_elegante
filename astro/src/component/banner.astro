---

const {tituloDos, parrafoDos,boton} = Astro.props;

import "../styles/style.css"
import "../styles/variables.css"

---


<div class="ultimo__contenedor">
    
            <h2 class="ultimo__titulo">{tituloDos}</h2>
            <p class="ultimo__parrafo">{parrafoDos}</p>
            <button class="ultimo__boton">{boton}</button>

</div>





<style>


.ultimo__contenedor{

    padding: 40px;
    text-align: center;
    min-height: 200px;
    margin: 50px;
    background-color: var(--colorBannerFondo);


}


.ultimo__titulo{

    font-size: 26px;
    margin-bottom: 15px;
    color: var(--colorFuente);
    
    
}


.ultimo__parrafo{

    
    font-size: 14px;
    margin-bottom: 25px;
    

}


.ultimo__boton{

    padding: 10px 20px;
    font-size: 20px;
    cursor: pointer;
    background-color: transparent;
    border-radius: 2px;
    border: 2px, solid, var(--colorFuente);


}

.ultimo__titulo, .ultimo__parrafo, .ultimo__boton {
    color: var(--colorFuente);
}

.ultimo__boton:hover{
    opacity: .5;
}

</style>

