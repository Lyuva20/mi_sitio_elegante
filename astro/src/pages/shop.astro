---
	import Layouts from "../layouts/layouts.astro"
	import { Image } from 'astro:assets';
		import bolsa from '../images/bolsa.webp';
		import cojin from '../images/cojin.webp';
		import jarron from '../images/jarron.webp';
		import mesa from '../images/mesa.webp';
		import mini from '../images/mini.webp';
		import silla from '../images/silla.webp';
		import tabla from '../images/tabla.webp';
		import tecno from '../images/tecno.webp';
		import cinco from '../images/cinco_estrellas.jpg';
		import dos from '../images/dos_estrellas.jpg';
		import tres from '../images/tres_estrellas.jpg';
		import una from '../images/una_estrella.jpg';


---


<Layouts titulo="Welcome to Our Shop" parrafo="Divi gives you the power to run a full-fledged online storefront.">

<main>

	<!--Tienda-->

<section class="tienda__contenedor">

	<div class="tienda__div">
		<Image class="div__img" src={jarron} alt="Jarron en una mesa"/>
		<h2>Air Plants</h2>
		<Image src={tres} alt="Tres estrellas"/>
		<p class="div__precio">£25.00</p>
	</div>

	<div class="tienda__div">
		<Image class="div__img" src={cojin} alt="Cojín en un sillón"/>
		<h2>Cartoon Pillow</h2>
		<Image src={cinco} alt="Cinco estrellas"/>
		<p class="div__dto">£25.00</p>
		<p class="div__ahora">£15.00</p>
	</div>

	<div class="tienda__div">
		<Image class="div__img" src={tabla} alt="Tabla de cortar"/>
		<h2>Cutting Board</h2>
		<p class="div__precio">£87.00</p>
	</div>

	<div class="tienda__div">
		<Image class="div__img" src={tecno} alt="Un movil, unos auriculares y una planta"/>
		<h2>Designer Headphones</h2>
		<p class="div__precio">£8.00</p>
	</div>

	<div class="tienda__div">
		<Image class="div__img" src={bolsa} alt="Bolsa eco"/>
		<h2>Earth Friendly Bag</h2>
		<Image src={dos} alt="Dos estrellas"/>
		<p class="div__precio">£28.00</p>
	</div>

	<div class="tienda__div">
		<Image class="div__img" src={silla} alt="Silla violeta en una sala"/>
		<h2>Purple Chair</h2>
		<p class="div__dto">£19.00</p>
		<p class="div__ahora">£15.00</p>
	</div>

	<div class="tienda__div">
		<Image class="div__img" src={mini} alt="Jarrones absurdamente caros"/>
		<h2>Simple Vase</h2>
		<p class="div__precio">£200.00</p>
	</div>

	<div class="tienda__div">
		<Image class="div__img" src={mesa} alt="Mesa de madera"/>
		<h2>Wooden Table</h2>
		<Image src={una} alt="Una estrella"/>
		<p class="div__precio">£42.00</p>
	</div>

	


</section>


<!--Último contenedor-->

        <div class="ultimo__contenedor">
    
            <h2 class="ultimo__titulo">News & Events</h2>
            <p class="ultimo__parrafo">Lorem ipsum dolor sit amet, consectetur adipiscing elit. In in risus eget lectus suscipit malesuada.</p>
            <button class="ultimo__boton">Follow</button>

        </div>



</main>

    
    
</Layouts>


<style>

.tienda__contenedor {

	display: grid;
	grid-template-columns: repeat(4, 1fr);
	gap: 1em;
	padding: 2rem;


	}


.tienda__div {

	padding: 1rem;
	text-align: left;
	margin-left: .5px

}


.div__img {

	max-width: 100%;
	height: auto;
	margin-bottom: 0.5rem;
	cursor: pointer;

}

.tienda__contenedor h2 {

	font-size: 18px;
	color: var(--textoShop);

}

.div__precio{

	color: var(--textoShop);
	font-size: 15px;
	

}

.div__dto{

	text-decoration: line-through;
	color: var(--precioShop);
	font-size: 15px;

}

.div__ahora{

	font-weight: bold;
	color: var(--textoShop);
	font-size: 15px;
}



.ultimo__contenedor{

    padding: 40px;
    text-align: center;
    min-height: 200px;
    margin: 50px;
    background-color: var(--colorBannerFondo);

    

}



.ultimo__titulo{

    font-size: 26px;
    margin-bottom: 15px;
    color: var(--colorFuente);
    
    
}


.ultimo__parrafo{

    
    font-size: 14px;
    margin-bottom: 25px;
    

}


.ultimo__boton{

    padding: 10px 20px;
    font-size: 20px;
    cursor: pointer;
    background-color: transparent;
    border-radius: 2px;
    border: 2px, solid, var(--colorFuente);


}

.ultimo__titulo, .ultimo__parrafo, .ultimo__boton {
    color: var(--colorFuente);
}

.ultimo__boton:hover{
    opacity: .5;
}


</style>
