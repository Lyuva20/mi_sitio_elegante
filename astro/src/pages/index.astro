---
	import Layouts from "../layouts/layouts.astro"
	import { Image } from 'astro:assets';
		import bocadillo from '../images/bocadillo.jpg';
		import gps from '../images/gps.jpg';
		import page from '../images/page.jpg';
		import rayitas from '../images/rayitas.jpg';


---


<Layouts 
tituloDos="Drop Me a Line" 
parrafoDos="Lorem ipsum dolor sit amet, consectetur adipiscing elit. In in risus eget lectus suscipit malesuada. Maecenas ut urna mollis, aliquam eros at, laoreet metus." 
boton="Contact"
title="Home | Mi sitio elegante"
description="Welcome to Mi Sitio Elegante: simple template with elegant design. ">



    <!--Header-->

    <header id="banner__header">
    
        <h2 id="banner__titulo"></h2>
        <p id="banner__parrafo"></p>
        <button id="banner__boton">Enter</button>

        <div id="banner__clic">
            <button id="clic__izquierda">←</button>
            <button id="clic__derecha">→</button>
        </div>

    </header>

    <main>

    <!--Segundo contenedor-->

        <div class="banner__segundo">

            <h2 class="segundo--titulo">We Are a Company of Passionate Designers and Developers</h2>

        </div>

    <!--Iconos-->

        <section class="contenedor__iconos">

            <div class="contenedor__divs">


				<Image src={page} alt="Icono de página"/>
                <h3 class="divs--titulo">Lorem Ipsum</h3>
                <p class="divs--parrafo">Divi will change the way you build websites forever. The advanced page builder makes it possible to build truly dynamic pages without learning code.</p>

            </div>

            <div class="contenedor__divs">
                
				<Image src={gps} alt="Icono gps"/>
                <h3>Lorem Ipsum</h3>
                <p>Divi will change the way you build websites forever. The advanced page builder makes it possible to build truly dynamic pages without learning code.</p>

            </div>

            <div class="contenedor__divs">
                
				<Image src={bocadillo} alt="Icono de bocadillo"/>
                <h3>Lorem Ipsum</h3>
                <p>Divi will change the way you build websites forever. The advanced page builder makes it possible to build truly dynamic pages without learning code.</p>

            </div>

            <div class="contenedor__divs">
                
				<Image src={rayitas} alt="Icono volumen"/>
                <h3>Lorem Ipsum</h3>
                <p>Divi will change the way you build websites forever. The advanced page builder makes it possible to build truly dynamic pages without learning code.</p>

            </div>

        </section>
    
    
    
</Layouts>



<style>

#banner__header {

    padding: 40px;
    text-align: center;
    min-height: 200px;
    margin: 50px;
    

}

#banner__titulo {

    font-size: 46px;
    margin-bottom: 15px;
    color: var(--colorFuente);

}

#banner__parrafo {

    font-size: 15px;
    margin-bottom: 25px;
}

#banner__parrafo, #banner__titulo, #banner__boton{

    color: var(--colorFuente);

}

#banner__boton {

    padding: 10px 20px;
    font-size: 20px;
    cursor: pointer;
    background-color: transparent;
    border-radius: 2px;
    border: 2px, solid, var(--colorFuente);
    


}

#banner__boton:hover{

    opacity: .5;

}

#banner__clic {

    display: grid;
    grid-template-columns: repeat(2,1fr);

}

#banner__clic button {
    
    border: none;
    cursor: pointer;
    background-color: transparent;
    color: var(--colorFuente);
    font-size: 25px;
    
    
}

#clic__derecha{

    justify-self: flex-end;
}

#clic__izquierda{

    justify-self: flex-start;
}

.banner__segundo{

    background-color: var(--colorBanner2);
    padding: 40px;
    text-align: center;
    width: 100%;
    min-height: 100px;
    display: flex;
    justify-content: center;
    
}

.segundo--titulo{

    color: var(--colorBannerFont);
    font-size: 30px;
    font-weight: lighter;
    width: 600px;

}


.contenedor__iconos{

    display: flex;
    flex-direction: row;
    justify-content: wrap;
    justify-content: center;
    align-content: center;
    gap: 1rem;
    height: 400px;
    margin-top: 50px;

}

.contenedor__divs{

    text-align: center;
    flex: 1;
    gap: 5px;
    margin: auto;
    color: var(--colorBannerFont);

}

.div--titulo{

    font-size: 18px;
    
}

.divs__parrafo{

    font-size: 14px;

}


</style>