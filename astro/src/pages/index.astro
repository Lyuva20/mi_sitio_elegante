---
	import Layouts from "../layouts/layouts.astro"
	import { Image } from 'astro:assets';
		import bocadillo from '../images/bocadillo.jpg';
		import gps from '../images/gps.jpg';
		import page from '../images/page.jpg';
		import rayitas from '../images/rayitas.jpg';


---


<Layouts>



    <!--Header-->

    <header id="banner__header">
    
        <h2 id="banner__titulo"></h2>
        <p id="banner__parrafo"></p>
        <button id="banner__boton">Enter</button>

        <div id="banner__clic">
            <button id="clic__izquierda">←</button>
            <button id="clic__derecha">→</button>
        </div>

    </header>

    <main>

    <!--Segundo contenedor-->

        <div class="banner__segundo">

            <h2 class="segundo--titulo">We Are a Company of Passionate Designers and Developers</h2>

        </div>

    <!--Iconos-->

        <section class="contenedor__iconos">

            <div class="contenedor__divs">


				<Image src={page} alt="Icono de página"/>
                <h3 class="divs--titulo">Lorem Ipsum</h3>
                <p class="divs--parrafo">Divi will change the way you build websites forever. The advanced page builder makes it possible to build truly dynamic pages without learning code.</p>

            </div>

            <div class="contenedor__divs">
                
				<Image src={gps} alt="Icono gps"/>
                <h3>Lorem Ipsum</h3>
                <p>Divi will change the way you build websites forever. The advanced page builder makes it possible to build truly dynamic pages without learning code.</p>

            </div>

            <div class="contenedor__divs">
                
				<Image src={bocadillo} alt="Icono de bocadillo"/>
                <h3>Lorem Ipsum</h3>
                <p>Divi will change the way you build websites forever. The advanced page builder makes it possible to build truly dynamic pages without learning code.</p>

            </div>

            <div class="contenedor__divs">
                
				<Image src={rayitas} alt="Icono volumen"/>
                <h3>Lorem Ipsum</h3>
                <p>Divi will change the way you build websites forever. The advanced page builder makes it possible to build truly dynamic pages without learning code.</p>

            </div>

        </section>
    
    <!--Último contenedor-->

        <div class="ultimo__contenedor">
    
            <h2 class="ultimo__titulo">Drop Me a Line</h2>
            <p class="ultimo__parrafo">Lorem ipsum dolor sit amet, consectetur adipiscing elit. In in risus eget lectus suscipit malesuada. Maecenas ut urna mollis, aliquam eros at, laoreet metus.</p>
            <button class="ultimo__boton">Contact</button>

        </div>

	</main>
    
</Layouts>



<style>

#banner__header {

    padding: 40px;
    text-align: center;
    min-height: 300px;
    margin: 50px;
    

}

#banner__titulo {

    font-size: 46px;
    margin-bottom: 15px;
    color: var(--colorFuente);

}

#banner__parrafo {

    font-size: 15px;
    margin-bottom: 25px;
}

#banner__parrafo, #banner__titulo, #banner__boton{

    color: var(--colorFuente);

}

#banner__boton {

    padding: 10px 20px;
    font-size: 20px;
    cursor: pointer;
    background-color: transparent;
    border-radius: 2px;
    border: 2px, solid, var(--colorFuente);


}

#banner__boton:hover{
    opacity: .5;
}

#banner__clic button {
    font-size: 20px;
    padding: 5px 15px;
    margin: 0 10px;
    border: none;
    cursor: pointer;
    background-color: transparent;
    color: var(--colorFuente);

}



.banner__segundo{

    background-color: var(--colorBanner2);
    padding: 40px;
    text-align: center;
    width: 100%;
    min-height: 100px;
    display: flex;
    justify-content: center;
    
    

}

.segundo--titulo{

    color: var(--colorBannerFont);
    font-size: 30px;
    font-weight: lighter;
    width: 600px;

}



.contenedor__iconos{

    display: flex;
    flex-direction: row;
    justify-content: wrap;
    justify-content: center;
    align-content: center;
    gap: 1rem;
    height: 400px;
    margin-top: 50px;

}

.contenedor__divs{

    text-align: center;
    flex: 1;
    gap: 5px;
    margin: auto;
    color: var(--colorBannerFont);


}

.div--titulo{

    font-size: 18px;
    
}

.divs__parrafo{

    font-size: 14px;

}



.ultimo__contenedor{

    padding: 40px;
    text-align: center;
    min-height: 200px;
    margin: 50px;
    background-color: var(--colorBannerFondo);

    

}



.ultimo__titulo{

    font-size: 26px;
    margin-bottom: 15px;
    color: var(--colorFuente);
    
    
}


.ultimo__parrafo{

    
    font-size: 14px;
    margin-bottom: 25px;
    

}


.ultimo__boton{

    padding: 10px 20px;
    font-size: 20px;
    cursor: pointer;
    background-color: transparent;
    border-radius: 2px;
    border: 2px, solid, var(--colorFuente);


}

.ultimo__titulo, .ultimo__parrafo, .ultimo__boton {
    color: var(--colorFuente);
}

.ultimo__boton:hover{
    opacity: .5;
}


</style>