---
	import Layouts from "../layouts/layouts.astro"
---


<Layouts titulo="Contact Us" parrafo="Your Subtitle Goes Here">

<main>

		<!--Iframe Reyes Formación -->

		<iframe src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3521.6863380171835!2d-16.640789924052275!3d28.034061111005062!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0xc6a99274d08bf5d%3A0x37fd73255be08694!2sReyes%20Formaci%C3%B3n!5e0!3m2!1ses!2ses!4v1760616598955!5m2!1ses!2ses" width="100%" height="350" style="border:0;" allowfullscreen="" loading="lazy" referrerpolicy="no-referrer-when-downgrade" loading="lazy" ></iframe>


	<section class="contenedor__asides">

		<!--Formulario de contacto-->

		<section class="contacto__contenedor">

			<h2 class="contacto__titulo">Get in Touch</h2>

			<form class="contacto__formulario" action="">

				<div class="contacto__inputs">
					<input class="contacto__input" type="text" name="nombre" placeholder="Nombre">
					<input class="contacto__input" type="email" name="email" placeholder="Email Address">
				</div>

				<textarea class="contacto__textarea" name="mensaje" placeholder="Message" id=""></textarea>

				<button class="contacto__boton" type="submit">Submit</button>


			</form>

		</section>

		<!--Más info-->

		<aside class="info__contenedor">

			<h2>More info</h2>
			<p>sit amet, consectetur adipiscing elit. Integer placerat metus id orci facilisis, in luctus eros laoreet. Mauris interdum augue varius, faucibus massa id, imperdiet tortor. Donec vel tortor molestie, hendrerit sem a, hendrerit arcu. Aliquam erat volutpat. Proin varius eros eros, non condimentum nis.</p>
			<p><span>Address</span>: 890 Lorem Ipsum Street #12
San Francisco, California 65432</p>
			<p><span>Phone</span>: 123.4567.890</p>
			<p><span>Business Hours</span>: 8a-6:30p M-F, 9a-2p S-S</p>



		</aside>

	</section>


</main>


    
    
</Layouts>

<style>

	.contenedor__asides{

		display: grid;
		grid-template-columns: 65% 35%;
		height: 500px;

	}

	.contacto__contenedor {
		
		gap: 40px;
		margin: 50px;

		}

	.contacto__titulo {

		font-size: 30px;
		font-weight: bold;
		color: var(--textoShop);
		margin-bottom: 25px;

		}

	.contacto__formulario {

		display: flex;
		flex-direction: column;
		gap: 20px;

		}

	.contacto__inputs {

		display: flex;
		gap: 20px;

		}

	.contacto__input,
	.contacto__textarea {
		
		width: 100%;
		padding: 14px;
		font-size: 18px;
		border: none;
		background-color: var(--fondoBlog);
		border-radius: 3px;
		
		}

	.contacto__textarea{

		height: 180px;
		resize: none;

		
	}

	.contacto__boton {

		align-self: flex-end;
		padding: 10px 22px;
		font-size: 15px;
		color: var(--colorBannerFondo);
		background-color: transparent;
		border: 2px solid var(--colorBannerFondo);
		border-radius: 4px;
		cursor: pointer;
		font-weight: 600;
		
		}

	.contacto__boton:hover{
		background-color: var(--colorBannerFondo);
		opacity: .5;
		color: var(--colorFondo);
		
	}


	.info__contenedor {

		color: var(--colorBannerFont);
		font-weight: 500;
		font-size: 15px;
		line-height: 1.7;
		margin: 50px 
		
		}

	.contacto__info h2 {

		font-size: 35px;
		font-weight: bold;
		color: var(--textoShop);
		margin-bottom: 25px;
		padding: auto;

		}

	.contacto__info p {

		margin: 20px;
		padding: auto;

		}

	span{
			font-weight: bold;
		}


</style>